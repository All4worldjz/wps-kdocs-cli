package cache

import (
	"crypto/sha256"
	"database/sql"
	"fmt"
	"sort"
	"strings"
	"sync"
	"time"

	_ "github.com/mattn/go-sqlite3"
)

type Event struct {
	UID       string
	Href      string
	ETag      string
	ICalData  string
	CreatedAt time.Time
	UpdatedAt time.Time
}

type Cache struct {
	db  *sql.DB
	mu  sync.RWMutex
	ctag string
	rev int64
}

func New(dbPath string) (*Cache, error) {
	db, err := sql.Open("sqlite3", dbPath+"?_journal_mode=WAL&_busy_timeout=5000")
	if err != nil {
		return nil, fmt.Errorf("open db: %w", err)
	}

	db.SetMaxOpenConns(1)
	db.SetMaxIdleConns(1)

	c := &Cache{db: db}

	if err := c.migrate(); err != nil {
		return nil, fmt.Errorf("migrate: %w", err)
	}

	if err := c.loadMeta(); err != nil {
		return nil, fmt.Errorf("load meta: %w", err)
	}

	return c, nil
}

func (c *Cache) migrate() error {
	stmts := []string{
		`CREATE TABLE IF NOT EXISTS events (
			uid        TEXT PRIMARY KEY,
			href       TEXT NOT NULL,
			etag       TEXT NOT NULL,
			ical_data  TEXT NOT NULL,
			created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
			updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
		)`,
		`CREATE INDEX IF NOT EXISTS idx_events_etag ON events(etag)`,
		`CREATE TABLE IF NOT EXISTS meta (
			key   TEXT PRIMARY KEY,
			value TEXT NOT NULL
		)`,
		`INSERT OR IGNORE INTO meta(key, value) VALUES ('ctag', '')`,
		`INSERT OR IGNORE INTO meta(key, value) VALUES ('revision', '0')`,
	}
	for _, stmt := range stmts {
		if _, err := c.db.Exec(stmt); err != nil {
			return fmt.Errorf("migrate: %w", err)
		}
	}
	return nil
}

func (c *Cache) loadMeta() error {
	c.mu.Lock()
	defer c.mu.Unlock()

	var val string
	c.db.QueryRow(`SELECT value FROM meta WHERE key='ctag'`).Scan(&val)
	c.ctag = val

	c.db.QueryRow(`SELECT value FROM meta WHERE key='revision'`).Scan(&val)
	fmt.Sscanf(val, "%d", &c.rev)

	return nil
}

func (c *Cache) StableCtag() string {
	c.mu.RLock()
	defer c.mu.RUnlock()
	return c.ctag
}

func (c *Cache) Revision() int64 {
	c.mu.RLock()
	defer c.mu.RUnlock()
	return c.rev
}

func (c *Cache) UpdateEvents(events []Event) (created []Event, updated []Event, deleted []string, err error) {
	c.mu.Lock()
	defer c.mu.Unlock()

	tx, err := c.db.Begin()
	if err != nil {
		return nil, nil, nil, fmt.Errorf("begin tx: %w", err)
	}
	defer tx.Rollback()

	rows, err := tx.Query(`SELECT uid, etag FROM events`)
	if err != nil {
		return nil, nil, nil, fmt.Errorf("query existing: %w", err)
	}
	existing := make(map[string]string)
	for rows.Next() {
		var uid, etag string
		rows.Scan(&uid, &etag)
		existing[uid] = etag
	}
	rows.Close()

	incoming := make(map[string]bool)

	stmt, err := tx.Prepare(`INSERT OR REPLACE INTO events(uid, href, etag, ical_data, updated_at) VALUES(?,?,?,?,?)`)
	if err != nil {
		return nil, nil, nil, fmt.Errorf("prepare upsert: %w", err)
	}
	defer stmt.Close()

	now := time.Now()
	for _, ev := range events {
		incoming[ev.UID] = true

		if oldETag, exists := existing[ev.UID]; !exists {
			created = append(created, ev)
		} else if oldETag != ev.ETag {
			updated = append(updated, ev)
		}

		if _, err := stmt.Exec(ev.UID, ev.Href, ev.ETag, ev.ICalData, now); err != nil {
			return nil, nil, nil, fmt.Errorf("upsert %s: %w", ev.UID, err)
		}
	}

	for uid := range existing {
		if !incoming[uid] {
			deleted = append(deleted, uid)
		}
	}

	for _, uid := range deleted {
		if _, err := tx.Exec(`DELETE FROM events WHERE uid=?`, uid); err != nil {
			return nil, nil, nil, fmt.Errorf("delete %s: %w", uid, err)
		}
	}

	changed := len(created) > 0 || len(updated) > 0 || len(deleted) > 0

	if changed {
		if err := c.recalcCtag(tx); err != nil {
			return nil, nil, nil, err
		}
		c.rev++
		if _, err := tx.Exec(`UPDATE meta SET value=? WHERE key='revision'`, fmt.Sprintf("%d", c.rev)); err != nil {
			return nil, nil, nil, fmt.Errorf("update revision: %w", err)
		}
	}

	if err := tx.Commit(); err != nil {
		return nil, nil, nil, fmt.Errorf("commit: %w", err)
	}

	return created, updated, deleted, nil
}

func (c *Cache) recalcCtag(tx *sql.Tx) error {
	rows, err := tx.Query(`SELECT etag FROM events ORDER BY etag`)
	if err != nil {
		return fmt.Errorf("query etags: %w", err)
	}
	defer rows.Close()

	var etags []string
	for rows.Next() {
		var etag string
		rows.Scan(&etag)
		etags = append(etags, etag)
	}

	sort.Strings(etags)
	hash := sha256.Sum256([]byte(strings.Join(etags, "\n")))
	c.ctag = fmt.Sprintf("%x", hash)

	_, err = tx.Exec(`UPDATE meta SET value=? WHERE key='ctag'`, c.ctag)
	return err
}

func (c *Cache) GetAllEvents() ([]Event, error) {
	c.mu.RLock()
	defer c.mu.RUnlock()

	rows, err := c.db.Query(`SELECT uid, href, etag, ical_data, created_at, updated_at FROM events ORDER BY uid`)
	if err != nil {
		return nil, fmt.Errorf("query events: %w", err)
	}
	defer rows.Close()

	var events []Event
	for rows.Next() {
		var ev Event
		if err := rows.Scan(&ev.UID, &ev.Href, &ev.ETag, &ev.ICalData, &ev.CreatedAt, &ev.UpdatedAt); err != nil {
			return nil, fmt.Errorf("scan event: %w", err)
		}
		events = append(events, ev)
	}
	return events, rows.Err()
}

func (c *Cache) GetEvent(uid string) (*Event, error) {
	c.mu.RLock()
	defer c.mu.RUnlock()

	var ev Event
	err := c.db.QueryRow(
		`SELECT uid, href, etag, ical_data, created_at, updated_at FROM events WHERE uid=?`,
		uid,
	).Scan(&ev.UID, &ev.Href, &ev.ETag, &ev.ICalData, &ev.CreatedAt, &ev.UpdatedAt)
	if err == sql.ErrNoRows {
		return nil, nil
	}
	if err != nil {
		return nil, fmt.Errorf("get event %s: %w", uid, err)
	}
	return &ev, nil
}

func (c *Cache) Close() error {
	return c.db.Close()
}